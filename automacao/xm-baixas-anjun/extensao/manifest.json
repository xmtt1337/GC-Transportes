{
  "manifest_version": 3,
  "name": "XM - Baixas Anjun",
  "version": "1.1",
  "description": "Dá baixa nos pacotes da Anjun um por vez, com a etiqueta achada nos PDFs como foto.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "vendor/pdf.worker.min.js",
        "vendor/pdf.min.js",
        "regras.js",
        "baixa.js",
        "painel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  }
}
