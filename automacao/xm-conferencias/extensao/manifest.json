{
  "manifest_version": 3,
  "name": "XM - Conferências",
  "version": "2.1",
  "description": "Conferências das transportadoras dentro dos portais delas: Shopee (Vapt Vupt, no SPX), Anjun (Conferência do dia, menu XMTT do portal de parceiros) e iMile (Conferência do dia, módulo Conferências no DS), integradas ao sistema XMTT.",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://spx.shopee.com.br/*",
    "https://*.susercontent.com/*",
    "https://newsupplier.anjunexpress.com/*",
    "https://ds.imile.com/*",
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "shopee/spx.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "regras.js",
        "shopee/conferencia.js",
        "shopee/vapt.js",
        "shopee/menu.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "anjun/anjun.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "anjun/xmtt-menu.js",
        "anjun/conferencia.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://ds.imile.com/*"
      ],
      "js": [
        "imile/imile.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://ds.imile.com/*"
      ],
      "js": [
        "imile/conferencia.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  }
}
