{
  "manifest_version": 3,
  "name": "XM - Consultas de telefone",
  "version": "2.6",
  "description": "Consulta pacotes em lote na transportadora e gera um CSV de contato.",
  "key": "",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://newsupplier.anjunexpress.com/*",
    "https://spx.shopee.com.br/*",
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "anjun.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "shopee.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*",
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "aba.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*",
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "menu.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pagina.html",
        "img/logo.png",
        "img/logo-claro.png"
      ],
      "matches": [
        "https://newsupplier.anjunexpress.com/*",
        "https://spx.shopee.com.br/*"
      ]
    }
  ],
  "action": {
    "default_title": "XM - Consultas de telefone",
    "default_icon": {
      "16": "img/icone-16.png",
      "32": "img/icone-32.png",
      "48": "img/icone-48.png",
      "128": "img/icone-128.png"
    },
    "default_popup": "escolha.html"
  },
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  }
}
