{
  "manifest_version": 3,
  "name": "XM Consulta",
  "version": "2.0",
  "description": "Consulta pacotes em lote na transportadora e gera um CSV de contato.",
  "key": "",
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "host_permissions": [
    "https://newsupplier.anjunexpress.com/*",
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "anjun.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "aba.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "XM Consulta"
  }
}
