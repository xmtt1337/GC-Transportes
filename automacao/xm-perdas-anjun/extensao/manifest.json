{
  "manifest_version": 3,
  "name": "XM - Perdas Anjun",
  "version": "1.2",
  "description": "Lê o rastreio dos pedidos com suspeita de perda na Anjun e diz quem estava com o pacote quando a entrega falhou.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "pagina.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "regras.js",
        "painel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "login.html"
      ],
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ]
    }
  ],
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  }
}
