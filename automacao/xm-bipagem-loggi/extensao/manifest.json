{
  "manifest_version": 3,
  "name": "XM - Bipagem Loggi",
  "version": "1.0",
  "description": "Avisa com som e tarja vermelha quando o pacote bipado na Loggi nao e das cidades escolhidas.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.loggi.com/*",
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.loggi.com/*"
      ],
      "js": [
        "loggi.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.loggi.com/*"
      ],
      "js": [
        "regras.js",
        "menu.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pagina.html",
        "img/logo.png",
        "img/logo-claro.png"
      ],
      "matches": [
        "https://*.loggi.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "XM - Bipagem Loggi: use o botao XM no site da Loggi",
    "default_icon": {
      "16": "img/icone-16.png",
      "32": "img/icone-32.png",
      "48": "img/icone-48.png",
      "128": "img/icone-128.png"
    }
  },
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  }
}
