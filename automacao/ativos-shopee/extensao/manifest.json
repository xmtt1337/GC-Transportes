{
  "manifest_version": 3,
  "name": "XM - Ativos Shopee",
  "version": "2.1",
  "description": "Ferramentas da XMTT dentro do SPX, pelo menu lateral: Ativos (disparar e conversas) e Conferência (Vapt Vupt), integradas ao sistema XMTT.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://spx.shopee.com.br/*",
    "https://*.susercontent.com/*",
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "spx.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "regras.js",
        "conversas.js",
        "vapt.js",
        "ativos.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  }
}
