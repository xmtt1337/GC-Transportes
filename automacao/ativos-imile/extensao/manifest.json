{
  "manifest_version": 3,
  "name": "XM - Ativos iMile",
  "version": "1.1",
  "description": "Dispara o ativo de confirmação de recebimento da iMile (confirmacao_imile) pelo WhatsApp da GC, direto do menu do DS da iMile, integrado ao sistema XMTT.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ds.imile.com/*",
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ds.imile.com/*"
      ],
      "js": [
        "imile.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://ds.imile.com/*"
      ],
      "js": [
        "regras.js",
        "ativos.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  }
}
