{
  "manifest_version": 3,
  "name": "GC Colador - ponte SPX",
  "version": "2.0",
  "description": "Recebe os codigos do colador (Python local), escreve no campo do SPX e captura a AT no instante em que ela nasce.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://spx.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "interceptador.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GC Colador"
  }
}
