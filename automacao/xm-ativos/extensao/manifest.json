{
  "manifest_version": 3,
  "name": "XM - Ativos",
  "version": "5.5",
  "description": "Ativos das transportadoras dentro dos portais delas (Shopee no SPX, iMile no DS, Anjun no portal de parceiros), pelo WhatsApp da GC e integrados ao sistema XMTT. Um login só para todas.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://spx.shopee.com.br/*",
    "https://*.susercontent.com/*",
    "https://ds.imile.com/*",
    "https://newsupplier.anjunexpress.com/*",
    "https://sistema-backend-i4uh.onrender.com/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "shopee/spx.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://spx.shopee.com.br/*"
      ],
      "js": [
        "shopee/regras.js",
        "shopee/conversas.js",
        "shopee/ativos.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://ds.imile.com/*"
      ],
      "js": [
        "imile/imile.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://ds.imile.com/*"
      ],
      "js": [
        "imile/regras.js",
        "imile/ativos.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "anjun/anjun.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://newsupplier.anjunexpress.com/*"
      ],
      "js": [
        "anjun/regras.js",
        "anjun/ativos.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "img/icone-16.png",
    "32": "img/icone-32.png",
    "48": "img/icone-48.png",
    "128": "img/icone-128.png"
  },
  "options_ui": {
    "page": "opcoes.html",
    "open_in_tab": true
  }
}
